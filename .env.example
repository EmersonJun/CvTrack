# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA deve ir para o Git (já está no .gitignore).

# ===== Banco de dados =====
POSTGRES_DB=cvmatch
POSTGRES_USER=cvmatch
POSTGRES_PASSWORD=cvmatch
DB_URL=jdbc:postgresql://localhost:5432/cvmatch

# ===== Segurança (usado a partir do commit de autenticação) =====
# Gere com: openssl rand -base64 64
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRATION_MINUTES=60

# ===== Inteligência Artificial (usado a partir do commit de análise) =====
# Valores possíveis: openai | ollama
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
